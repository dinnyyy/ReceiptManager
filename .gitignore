# Xcode / Swift
.build/
DerivedData/
*.xcodeproj
*.xcworkspace
!default.xcworkspace
.swiftpm/
*.xcuserstate
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# macOS
.DS_Store

# Environment / secrets
.env
.env.*
*.xcconfig.local
# Config/Secrets.xcconfig is intentionally NOT ignored: xcodegen requires
# the file to physically exist (project.yml references it unconditionally),
# and it ships with safe placeholder values since AppEnvironment.localOnly()
# never reads them. Put real Supabase credentials in it locally once you
# switch to .live() - just don't commit real values over the placeholders.

# Supabase local dev
supabase/.branches/
supabase/.temp/

# Node (graphify)
node_modules/

# Graphify local/ephemeral state (kept out of VCS; regenerate with `graphify update`)
.graphify/cache/
.graphify/*.log
.graphify/branch.json
.graphify/worktree.json
.graphify/needs_update
.graphify/.graphify_*
.graphify/20*/
